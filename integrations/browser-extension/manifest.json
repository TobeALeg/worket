{
  "manifest_version": 3,
  "name": "Worket 选定网页内容",
  "version": "0.1.1",
  "description": "仅在你点击后读取当前页面选中的正文，预览后交给本机 Worket 确认。",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
