{
  "name": "workpet",
  "productName": "Worket",
  "version": "0.1.4",
  "private": true,
  "description": "记录各执行者的工作，在同一项工作中交接和继续。",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc && node scripts/copy-static.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --experimental-strip-types --test test/**/*.test.ts",
    "start": "npm run package:mac && ./release/Worket-darwin-arm64/Worket.app/Contents/MacOS/Worket",
    "dev": "npm run package:mac && ./release/Worket-darwin-arm64/Worket.app/Contents/MacOS/Worket --dev",
    "setup:integrations": "npm run build && node scripts/install-integrations.mjs",
    "qa:current-context": "npm run build && node scripts/qa-current-context.mjs",
    "qa:workbuddy-context": "npm run build && node scripts/qa-workbuddy-context.mjs",
    "qa:desktop-roundtrip:list": "node scripts/qa-desktop-roundtrip.mjs --list",
    "qa:desktop-roundtrip": "node scripts/qa-desktop-roundtrip.mjs",
    "eval:extraction": "node evals/extraction/cli.mjs",
    "eval:extraction:review": "node evals/extraction/review-server.mjs",
    "eval:extraction:adjudicate": "node evals/extraction/adjudication-server.mjs",
    "eval:extraction:test": "node --test evals/extraction/test/*.test.mjs",
    "qa:package": "WORKPET_EXECUTABLE_PATH=$PWD/release/Worket-darwin-arm64/Worket.app/Contents/MacOS/Worket node scripts/qa-electron.mjs",
    "qa:contract": "npm run build && node scripts/qa-contract-baseline.mjs",
    "qa:improvement-boundary": "npm run build && node scripts/qa-improvement-boundary.mjs",
    "qa:source-presence": "npm run build && WORKET_SOURCE_ABSENCE=1 node scripts/qa-codex-history.mjs",
    "qa:codex-history": "npm run build && node scripts/qa-codex-history.mjs",
    "qa:source-revisions": "npm run build && node scripts/qa-source-revisions.mjs",
    "qa:delivery-receipts": "npm run build && node scripts/qa-delivery-receipts.mjs",
    "qa:skills": "npm run build && WORKET_SKILL_REPLAY=test/fixtures/skill-extraction/accepted node scripts/qa-skill-dependencies.mjs",
    "qa:mcp-context": "npm run build && node scripts/qa-mcp-context.mjs",
    "qa:contract:semantics": "npm run build && WORKET_SEMANTIC_REPLAY_ROOT=test/fixtures/semantic-evolution node scripts/qa-evolution-semantics.mjs",
    "qa:contract:continuous": "npm run build && WORKET_E2E_CONTINUOUS=1 WORKET_E2E_REPLAY=test/fixtures/contracts/video node scripts/qa-contract-e2e.mjs",
    "qa:contract:evolution": "npm run build && node scripts/qa-contract-evolution-baseline.mjs",
    "package:mac": "npm run build && electron-packager . Worket --platform=darwin --arch=arm64 --app-bundle-id=dev.workpet.desktop --icon=assets/WorkPet.icns --extra-resource=assets/WorkPet.png --asar.unpackDir=integrations --asar.unpack=dist/foreground-context --out=release --overwrite --ignore='^/research($|/)' --ignore='^/test($|/)' --ignore='^/output($|/)' --ignore='^/release($|/)' --ignore='^/server($|/)' --ignore='^/.worket-server($|/)'",
    "ai:serve": "npm run build:server && node server/start.mjs",
    "build:server": "tsc -p server/tsconfig.json",
    "ai:serve:env": "npm run build:server && node server/start-env.mjs",
    "release:mac": "node scripts/release-mac.mjs"
  },
  "devDependencies": {
    "@electron/packager": "19.0.1",
    "@types/node": "24.10.0",
    "electron": "44.1.1",
    "playwright": "^1.55.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TobeALeg/worket.git"
  }
}
